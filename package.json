{
  "name": "form-aiml",
  "version": "1.0.0",
  "description": "CA Desk Enterprise Office Management Platform with Integrated TaxWise Engine",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:all": "node run-all.js",
    "start:cadesk": "npm --prefix ca-desk start",
